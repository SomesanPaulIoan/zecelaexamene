# Copy this to .env for local development. Never commit the real .env — it's gitignored.

DATABASE_URL="postgresql://zle:local-development-password@127.0.0.1:5433/zle?schema=public"

# Used to build absolute links in emails (e.g. "access your course" button)
SITE_URL="http://localhost:3000"

SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Stripe test keys — get from a sandbox (`stripe sandbox create`) or
# https://dashboard.stripe.com/test/apikeys. Run
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and paste the signing
# secret it prints into STRIPE_WEBHOOK_SECRET — required, not optional, for orders to ever
# mark as paid.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# SmartBill (Romanian SRL, CIF 53187997)
SMARTBILL_USERNAME=""
SMARTBILL_TOKEN=""
SMARTBILL_CIF="53187997"
SMARTBILL_SERIES="ZLE"
INVOICE_VAT_RATE="0"

# SMTP (Hostinger) — STARTTLS on port 587
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_USER="no-reply@zecelaexamene.ro"
SMTP_PASSWORD=""
SMTP_FROM="no-reply@zecelaexamene.ro"

# Cross-site integration: zecelainfo.ro calls POST /api/export-user-courses with this key
# to pull a user's course access (progress transfer). Must match the value zecelainfo.ro is
# configured with — reused verbatim from the legacy site's api/export-user-courses.php.
EXPORT_USER_COURSES_API_KEY=""

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Internal notification emails (contact form, return/withdrawal requests) are sent to
# office@zecelaexamene.ro and CC'd here so they don't get missed.
OWNER_NOTIFY_EMAIL=""

# Google OAuth ("Continuă cu Google") — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Path to the legacy MySQL dump, used only by the one-time migration script
LEGACY_SQL_DUMP_PATH="/path/to/private/legacy.sql"

# Reference date the migration script uses for the "+1 year access" extension rule.
# Pass explicitly so re-running the migration later doesn't silently shift everyone's expiry.
MIGRATION_REFERENCE_DATE="2026-09-16"
