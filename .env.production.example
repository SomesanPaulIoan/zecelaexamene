# Copy this to .env.production on the VPS and fill in real values. Never commit the real
# file — it's gitignored. docker-compose.prod.yml loads it for postgres, migrate, and app.

# Postgres password — used by BOTH the `postgres` service (as POSTGRES_PASSWORD) and here
# inside DATABASE_URL. Keep them equal; there's deliberately only one password to manage.
POSTGRES_PASSWORD="change-me-to-a-long-random-value"
DATABASE_URL="postgresql://zle:change-me-to-a-long-random-value@postgres:5432/zle?schema=public"

# Used to build absolute links in emails (e.g. "access your course" button) — set to the
# real production domain.
SITE_URL="https://zecelaexamene.ro"

# Session — generate with `openssl rand -base64 32`, must be at least 32 characters.
SESSION_SECRET=""

# Stripe LIVE keys. Prefer a restricted API key (rk_live_...) scoped to only what checkout/
# webhooks need, over a full secret key. STRIPE_WEBHOOK_SECRET is required, not optional —
# create a live webhook endpoint in the Stripe Dashboard pointed at
# https://<your-domain>/api/webhooks/stripe subscribed to checkout.session.completed,
# checkout.session.async_payment_succeeded, and checkout.session.async_payment_failed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# SmartBill (Romanian SRL, CIF 53187997) — company is not a VAT payer, keep VAT at 0.
SMARTBILL_USERNAME=""
SMARTBILL_TOKEN=""
SMARTBILL_CIF="53187997"
SMARTBILL_SERIES="ZLE"
INVOICE_VAT_RATE="0"

# SMTP (Hostinger) — STARTTLS on port 587
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_USER="no-reply@zecelaexamene.ro"
SMTP_PASSWORD=""
SMTP_FROM="no-reply@zecelaexamene.ro"

# Cross-site integration: zecelainfo.ro calls POST /api/export-user-courses with this key
# to pull a user's course access (progress transfer). Must match the value zecelainfo.ro is
# configured with — reused verbatim from the legacy site's api/export-user-courses.php.
EXPORT_USER_COURSES_API_KEY=""

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Internal notification emails (contact form, return/withdrawal requests) are sent to
# office@zecelaexamene.ro and CC'd here so they don't get missed.
OWNER_NOTIFY_EMAIL=""

# Google OAuth ("Continuă cu Google") — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://zecelaexamene.ro/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
